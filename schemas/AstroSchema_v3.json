{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astroos.dev/schema/astroschema/v3",
  "title": "AstroSchema v3",
  "type": "object",
  "required": ["schema_version", "chart_id", "time", "location", "bodies", "angles", "houses", "provenance"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "chart_id": {"type": "string", "minLength": 1},
    "time": {
      "type": "object",
      "required": ["local_datetime", "timezone", "utc_datetime", "julian_day_ut"],
      "properties": {
        "local_datetime": {"type": "string"},
        "timezone": {"type": "string"},
        "utc_datetime": {"type": "string", "format": "date-time"},
        "julian_day_ut": {"type": "number"},
        "utc_offset_seconds": {"type": "integer"},
        "dst_applied": {"type": "boolean"}
      }
    },
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "elevation_m": {"type": "number"}
      }
    },
    "bodies": {"type": "array", "items": {"$ref": "#/$defs/celestialObject"}},
    "angles": {"type": "array", "items": {"type": "object"}},
    "houses": {"type": "array", "items": {"type": "object"}},
    "aspects": {"type": "array", "items": {"type": "object"}},
    "midpoints": {"type": "array", "items": {"type": "object"}},
    "fixed_stars": {"type": "array", "items": {"type": "object"}},
    "dignities": {"type": "array", "items": {"type": "object"}},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "celestialObject": {
      "type": "object",
      "required": ["id", "longitude", "latitude", "speed", "retrograde"],
      "properties": {
        "id": {"type": "string"},
        "longitude": {"type": "number", "minimum": 0, "maximum": 360},
        "latitude": {"type": "number"},
        "distance_au": {"type": "number"},
        "speed": {"type": "number"},
        "retrograde": {"type": "boolean"},
        "declination": {"type": "number"}
      }
    }
  }
}
