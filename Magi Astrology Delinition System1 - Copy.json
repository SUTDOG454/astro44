  "philosophical_foundations": {
    "principles": [
      {
        "id": "principle_1",
        "name": "Cosmic Sympathy",
        "description": "The celestial pattern is resonant, not causative—a higher-dimensional signature manifesting through all scales",
        "corollary": "As above, so below; as within, so without",
        "implications": [
          "synchronicity",
          "fractal resonance",
          "pattern recognition"
        ]
      },
      {
        "id": "principle_2",
        "name": "Anima Mundi Participation",
        "description": "Planets as concentrations of archetypal consciousness with which one can engage dialogically",
        "corollary": "All is ensouled; consciousness pervades cosmos",
        "implications": [
          "planetary intelligences",
          "symbolic perception",
          "participatory cosmology"
        ]
      },
      {
        "id": "principle_3",
        "name": "Telesmatic Imagination",
        "description": "Astrological symbols as gateways to direct experiential knowing through visualization and embodiment",
        "corollary": "To know is to become",
        "implications": [
          "ritual magic",
          "pathworking",
          "active imagination"
        ]
      }
    ],
    "cosmology": {
      "geocentric": {
        "purpose": "Earth-centered perspective; shows personal experience and manifestation",
        "use_cases": [
          "natal analysis",
          "psychological insight",
          "mundane events"
        ],
        "considered_real": "phenomenological reality"
      },
      "heliocentric": {
        "purpose": "Sun-centered perspective; shows soul's purpose and cosmic alignment",
        "use_cases": [
          "karmic patterns",
          "super aspects",
          "soul evolution"
        ],
        "considered_real": "archetypal reality"
      },
      "draconic": {
        "purpose": "Node-centered perspective; shows karmic blueprint and soul's journey",
        "use_cases": [
          "past life patterns",
          "soul contracts",
          "dharmic purpose"
        ],
        "considered_real": "causal reality"
      }
    }
  },
